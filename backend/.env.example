# SkillGap Analytics Backend - Environment Variables
# Copy this file to .env and fill in your values

# ─── App Settings ─────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database (Supabase or local Postgres + pgvector) ─────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillgap
# For Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ─── AI Keys ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key...

# ─── RAG Config ───────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini
RAG_TOP_K=5
